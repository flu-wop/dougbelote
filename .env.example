# ──────────────────────────────────────────────────────────────────
# dougbelote.com — environment variables
# Copy this file to .env.local and fill in real values.
# Nothing here is needed for the static starter; these are scaffolded
# for the future booking-system integration (same stack as MCS).
# ──────────────────────────────────────────────────────────────────

# Resend (contact form + future booking confirmations)
RESEND_API_KEY=re_xxx

# Turso (future booking DB — one DB per site)
TURSO_DATABASE_URL=libsql://dougbelote-bookings-flu-wop.turso.io
TURSO_AUTH_TOKEN=xxx

# Stripe (future paid sessions, if Doug ever sells lessons/packs)
STRIPE_SECRET_KEY=sk_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx
